# Copy to .env and fill in. .env is gitignored — never commit real values.

# Entra app registration (public client, device-code flow enabled).
# These are identifiers, not secrets; a public client has no client secret.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Base URL of a CRM implementing the contract described in README.md.
# A path is preserved, e.g. https://crm.example.com/api-gateway
CRM_API_BASE_URL=https://crm.example.com

# Optional — override if your CRM mounts these routes elsewhere.
# Relative to CRM_API_BASE_URL.
#CRM_AUTH_PATH=api/auth/entra
#CRM_ACCOUNTS_PATH=api/accounts
